{
  "name": "research-rag-node",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 6100 --strictPort",
    "check": "tsc -b --pretty false",
    "test": "node --test tests/*.test.mjs",
    "start": "node --env-file-if-exists=.env server.mjs",
    "serve": "npm run build && npm start"
  },
  "dependencies": {
