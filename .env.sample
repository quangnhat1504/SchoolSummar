# Application
NODE_ENV=development
APP_NAME=research-rag
APP_URL=http://localhost:6000
PORT=6000
LOG_LEVEL=info

# Authentication
# Use the subject from this provider as users.auth_subject.
AUTH_ISSUER_URL=
AUTH_AUDIENCE=
AUTH_SECRET=

# PostgreSQL / Neon
# Use the direct connection for migrations and the pooled connection for the API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_POOLER=postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require
DATABASE_SSL=true

# Object storage (S3-compatible)
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=research-rag
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=900

# Background jobs / pipeline
REDIS_URL=redis://localhost:6379/0
PIPELINE_MAX_ATTEMPTS=3
PIPELINE_CONCURRENCY=2

# Layout detection and OCR services
LAYOUT_SERVICE_URL=http://localhost:8001
LAYOUT_SERVICE_API_KEY=
OCR_SERVICE_URL=http://localhost:8002
OCR_SERVICE_API_KEY=

# Embeddings and generation
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1536
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Retrieval
RETRIEVAL_TOP_K=20
RERANK_TOP_K=8
RAG_MAX_CONTEXT_TOKENS=12000
