# Application
NODE_ENV=development
APP_NAME=research-rag
APP_URL=http://localhost:6100
PORT=6100
LOG_LEVEL=info

# Authentication
# Use the subject from this provider as users.auth_subject.
AUTH_ISSUER_URL=
AUTH_AUDIENCE=
AUTH_SECRET=

# PostgreSQL / Neon
# Use the direct connection for migrations and the pooled connection for the API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_POOLER=postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require
DATABASE_SSL=true

# Object storage (S3-compatible)
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=research-rag
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=900

# Background jobs / pipeline
REDIS_URL=redis://localhost:6379/0
PIPELINE_MAX_ATTEMPTS=3
PIPELINE_CONCURRENCY=2

# Layout detection and OCR services
LAYOUT_SERVICE_URL=http://localhost:8001
LAYOUT_SERVICE_API_KEY=
OCR_SERVICE_URL=http://localhost:8002
OCR_SERVICE_API_KEY=

# Embeddings and generation
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1536
# LLM provider routing. The server tries providers in order and falls back to
# grounded extractive answers if all configured providers are unavailable.
LLM_ENABLED=true
LLM_PROVIDER=auto
LLM_PROVIDER_ORDER=groq,openrouter,huggingface,ollama,custom
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
LLM_CIRCUIT_BREAKER_THRESHOLD=2
LLM_CIRCUIT_BREAKER_COOLDOWN_MS=30000
LLM_MAX_TOKENS=700

# Recommended free hosted provider: Groq free plan + Llama 3.1 8B.
# Groq's free quota is rate-limited; create a key at https://console.groq.com/keys.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Free fallback router. It may select a different free model when the preferred
# model is unavailable. Set OPENROUTER_MODEL to a concrete model if required.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:6100
OPENROUTER_APP_NAME=Research RAG

# Hugging Face Inference Providers. Free credits are limited and availability
# depends on the selected provider/model.
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct:fastest

# Optional local fallback. Install the model with: ollama pull llama3.1:8b
# Leave OLLAMA_BASE_URL empty to disable it.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_MODEL=llama3.1:8b

# Legacy single-provider compatibility. Prefer the provider-specific fields above.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Retrieval
RETRIEVAL_TOP_K=20
RERANK_TOP_K=8
RAG_MAX_CONTEXT_TOKENS=12000

# Docling document conversion
# mock works without Python/Docling; use service or cli in production.
DOCLING_MODE=mock
DOCLING_SERVICE_URL=
DOCLING_SERVICE_PATH=/v1/convert/file
DOCLING_SERVICE_API_KEY=
DOCLING_TIMEOUT_MS=120000
DOCLING_MAX_RETRIES=3
DOCLING_PIPELINE=standard
DOCLING_OCR=true
DOCLING_TABLES=true
DOCLING_CHUNKS_TYPE=hybrid
DOCLING_MAX_PAGES=100
DOCLING_MAX_FILE_SIZE=52428800
DOCLING_CLI=docling
